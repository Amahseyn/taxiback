# Backend Production Environment Variables Template
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://yourdomain.com

# PostgreSQL / MySQL Production Database URL
# Format: postgresql://<user>:<secure_password>@<host>:5432/<database>?schema=public
DATABASE_URL="postgresql://taxi_user:SECURE_DB_PASSWORD@127.0.0.1:5432/taxiback_prod?schema=public"

# Secure JWT Authentication Secrets (Generate using `openssl rand -base64 32`)
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_ACCESS_SECRET_32_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_RANDOM_REFRESH_SECRET_32_BYTES
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=your_email@domain.com
SMTP_PASS=your_secure_smtp_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=TaxiOS

# Payment & Maps Integrations
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
GOOGLE_MAPS_API_KEY=AIzaSy...

# File Uploads
UPLOAD_DIR=/var/uploads
MAX_FILE_SIZE_MB=10
